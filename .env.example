# Copy to .env and fill in. .env is gitignored.

# Recordari MCP endpoint and a benchmark-scoped API key (required for --system recordari|all).
# Use a DEDICATED benchmark workspace key — the harness purges its domain on setup/teardown.
RECORDARI_MCP_URL=https://api.recordar.io/mcp
RECORDARI_API_KEY=

# Local Mem0 bridge (required for --system mem0|mem0naive|all). Defaults to http://localhost:8888.
MEM0_URL=http://localhost:8888

# OpenAI key used by the Mem0 bridge (mem0_server) for extraction/embeddings.
OPENAI_API_KEY=
